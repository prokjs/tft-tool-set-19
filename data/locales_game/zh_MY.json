    "One Monster Band": {
      "name": "一只怪乐团",
      "description": "1 【纳什男爵】占用2个弈子栏位，且为不可阻挡状态。\n【纳什男爵】首次施法后，他会用歌声笼罩全场，从而从所有敌人身上偷取5%物理加成、法术加成、攻击速度和暴击几率。"
    },
    "Producer": {
      "name": "音乐总监",
      "description": "1 在【娑娜】登场时，选择一支要客串的乐队，从而获得该乐队的羁绊。\n【娑娜】会将所有额外物理加成和攻击速度转化为法术加成。"
    },
    "Record Mogul": {
      "name": "唱片大亨",
      "description": "1 Gain a Record Contract now and every 4 rounds. Contracted champions gain 5% Damage Amp and their kills grant Dr. Mundo 25 permanent Health.\nTotal Health: 25\nNext Contract: ?/4\nThe Record Contract is returned when the Recording Artist is sold or benched."
    },
    "Synthwave": {
      "name": "合成器浪潮",
      "description": "1 在35%生命值时，获得持续6秒的护盾，数额相当于本场战斗中获得的50%治疗和护盾效果。"
    },
    "Tango": {
      "name": "探戈",
      "description": "1 【崔斯特】将相距最近的友军标记为他的【探戈舞伴】。他们燃起激情，获得15%攻击速度。他们的伤害会对敌人们造成持续3秒的1%灼烧效果和33%重伤效果。\n灼烧：每秒造成相当于目标一部分最大生命值的真实伤害\n重伤：降低受到的治疗量"
    },
    "Windblessed": {
      "name": "赐福之风",
      "description": "1 Combat Start: Your strongest Janna releases a tornado that travels forward, knocking up enemies in its path for 1.25/1.75/99 seconds."
    }
  },
